# [INPUT]: 依赖 varlock 1.22.0、`@varlock/infisical-plugin` 2.1.3、`@varlock/nextjs-integration` 1.2.4（经 package.json overrides 替换 `@next/env`）
# [OUTPUT]: 声明项目全部环境变量的类型、敏感性和用途；本地有 Infisical 机器身份时从 Infisical 欧洲区批量取值
# [POS]: 环境变量的唯一定义处，取代旧 .env.example。只含声明和示例，不含任何值，可以提交
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md 与 README.md 的环境变量章节
#
# 取值来源：
#   - 本地（ovh-dev）：.env.local 提供 INFISICAL_CLIENT_ID/SECRET，varlock 从 Infisical 的 dev 环境取值。
#   - Vercel：Infisical Secret Sync 把 prod 环境写进 Vercel 项目变量。构建时没有 Infisical 凭据，
#     插件跳过，varlock 只做类型校验，值来自 Vercel 注入的 process.env。
#   - 优先级：本文件 < Infisical（有凭据时）< .env < .env.local < process.env。
#
# 设计约定：
#   - 不写默认值，示例写在 `@example`。默认值会被烘进 Vercel 构建，改变线上行为。
#   - 除 NEXT_PUBLIC_ 外默认敏感；不是秘密的服务端配置逐项标 `@public`。
#   - 全部 `@dynamic`：服务端变量继续在运行时从 process.env 读取；NEXT_PUBLIC_ 仍由 Next.js 在构建时内联。
#   - 全部可选（`@defaultRequired=false`）。缺值时由各功能自己降级，与迁移前行为一致。
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(NEXT_PUBLIC_)
# @defaultDynamic=true
# @generateTsTypes(path=env.d.ts)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(projectId=20c385dc-811c-41e2-bc37-a6d52ac2f1e5, environment=$APP_ENV, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, siteUrl=https://eu.infisical.com)
# @setValuesBulk(infisicalBulk(), enabled=not(isEmpty($INFISICAL_CLIENT_SECRET)))
# ---

# Vercel 注入的部署类型；本地为空。
# @public @type=enum(development, preview, production)
VERCEL_ENV=

# 当前环境，对应 Infisical 环境 slug。Vercel 的 production 与 preview 都对应 prod，其余为 dev。
# @public @type=enum(dev, prod)
APP_ENV=remap($VERCEL_ENV, production, prod, preview, prod, dev)

# Infisical 机器身份（Universal Auth）。留空则不访问 Infisical。
# 只在 .env.local 或 process.env 中提供，不要写进本文件。
# @public @type=infisicalClientId
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @internal
INFISICAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 站点
# -----------------------------------------------------------------------------

# 站点根地址。缺省时代码回退到 https://pennlam.com。
# @type=url @example=https://pennlam.com
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Contentful（文章、页面、Journey）
# -----------------------------------------------------------------------------

# @public
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
# 草稿预览入口 /api/draft 的校验密钥。
CONTENTFUL_PREVIEW_SECRET=

# Contentful webhook 调用 /api/revalidate 时放在 x-revalidate-secret 请求头；
# 手动重验证（?path=）时放在 secret 查询参数。未设置时接口拒绝所有重验证请求。
NEXT_REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Supabase（浏览量、评论、Musings）
# -----------------------------------------------------------------------------

# @public @type=url
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# @type=url
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 本地 IPv4 网络用 Supabase pooler 连接串，通常是 6543 端口。
SUPABASE_DB_URL=
# SUPABASE_DB_URL 为空时的备用连接串。
DATABASE_URL=

# -----------------------------------------------------------------------------
# Better Auth（评论登录，GitHub OAuth）
# -----------------------------------------------------------------------------

BETTER_AUTH_SECRET=
# @public @type=url
BETTER_AUTH_URL=
# @public
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Musings（GitHub Issues 写入）
# -----------------------------------------------------------------------------

# 发布 Musing 的口令。
MUSING_CODE=
GITHUB_PAT=
# 格式 owner/repo；为空时代码回退到上游默认仓库。
# @public
GITHUB_REPO=

# -----------------------------------------------------------------------------
# 书签与阅读
# -----------------------------------------------------------------------------

# Raindrop.io 访问令牌，只在服务端使用。
RAINDROP_ACCESS_TOKEN=
# 微信读书书架（/bookmarks/books）。不填时回退到 Raindrop 的 books 收藏夹。格式 wrk-xxxx。
WEREAD_API_KEY=
# /bookmarks/music 唱机的默认网易云歌单 ID：打开短链跳转后 URL 中 id= 后的数字。
NEXT_PUBLIC_NETEASE_PLAYLIST_ID=
# 链接预览（/api/notion-mention-link）；为空时走 Microlink 免费额度。
MICROLINK_API_KEY=

# -----------------------------------------------------------------------------
# 飞书多维表格（Friends 等）
# -----------------------------------------------------------------------------

# @public
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BITABLE_APP_TOKEN=
# @public
LARK_BITABLE_TABLE_ID=
# @public
LARK_FRIENDS_TABLE_ID=

# -----------------------------------------------------------------------------
# Cloudinary（Visual 素材）
# -----------------------------------------------------------------------------

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Tinybird 统计
# -----------------------------------------------------------------------------

NEXT_PUBLIC_TINYBIRD_TOKEN=
# @type=url
NEXT_PUBLIC_TINYBIRD_TRACKER_HOST=

# -----------------------------------------------------------------------------
# 开发开关
# -----------------------------------------------------------------------------

# 设为 true 时，开发环境也累计浏览量。
# @public @type=enum(true, false)
ENABLE_VIEW_COUNT_IN_DEV=
