#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
required_bun_version="1.3.8"
required_vercel_version="59.16.0"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

install_system_dependencies() {
  local missing=()

  command -v curl >/dev/null 2>&1 || missing+=(curl)
  command -v unzip >/dev/null 2>&1 || missing+=(unzip)

  if ((${#missing[@]} > 0)); then
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
  fi
}

install_bun() {
  if [[ -x "$HOME/.bun/bin/bun" ]] && [[ "$($HOME/.bun/bin/bun --version)" == "$required_bun_version" ]]; then
    return
  fi

  curl -fsSL https://bun.com/install | bash -s "bun-v${required_bun_version}"
}

configure_bun_path() {
  local profile="$HOME/.bash_profile"
  local marker="# Penn.dev.blog Bun toolchain"

  if ! grep -Fqx "$marker" "$profile" 2>/dev/null; then
    cat >>"$profile" <<'EOF'

# Penn.dev.blog Bun toolchain
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
EOF
  fi
}

install_dependencies() {
  cd "$repo_root"
  "$HOME/.bun/bin/bun" install --frozen-lockfile
}

install_vercel_cli() {
  if [[ -x "$HOME/.bun/bin/vercel" ]] &&
    "$HOME/.bun/bin/vercel" --version 2>&1 | grep -Fq "$required_vercel_version"; then
    return
  fi

  "$HOME/.bun/bin/bun" add --global "vercel@${required_vercel_version}"
}

prepare_environment() {
  cd "$repo_root"
  [[ -f .env.local ]] || cp -- .env.example .env.local
}

run_step "Checking system dependencies" install_system_dependencies
run_step "Installing Bun ${required_bun_version}" install_bun
run_step "Configuring Bun for login shells" configure_bun_path
run_step "Installing project dependencies" install_dependencies
run_step "Installing Vercel CLI ${required_vercel_version}" install_vercel_cli
run_step "Preparing local environment template" prepare_environment

printf '\nOrb setup complete.\n'
